# Copy this file to .env and fill in the values for the provider you use.
# .env is git-ignored. Never commit a real key.
#
# These names are the ones rag/llm_client.py and rag/config.py actually read.
# Loading happens automatically at import - no export needed.

# ---------------------------------------------------------------------------
# Required: pick a provider and a model
# ---------------------------------------------------------------------------
# provider: openai | groq | together | ollama
LLM_PROVIDER=
LLM_MODEL=

# ---------------------------------------------------------------------------
# The API key for the provider you picked above.
# Fill in exactly one. The others can stay blank.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Override the endpoint. Useful for Ollama, proxies, or an OpenAI-compatible
# gateway. Leave blank to use the provider's default.
#   ollama        -> http://localhost:11434/v1
#   local gateway -> https://your-gateway.example/v1
LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Model name examples (pick one that matches your provider and key)
# ---------------------------------------------------------------------------
# openai    -> gpt-4o-mini
# groq      -> llama-3.3-70b-versatile
# together  -> meta-llama/Llama-3-8b-chat-hf
# ollama    -> llama3.1
#
# Ollama needs no key at all; leave every *_API_KEY blank.
